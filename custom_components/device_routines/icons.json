{
  "entity": {
    "binary_sensor": {
      "hub_problem": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "sensor": {
      "schedule": {
        "default": "mdi:calendar-clock"
      },
      "health": {
        "default": "mdi:heart-pulse",
        "state": {
          "degraded": "mdi:heart-flash",
          "error": "mdi:heart-off"
        }
      },
      "hub_routines": {
        "default": "mdi:calendar-check"
      }
    }
  },
  "triggers": {
    "action_skipped": {
      "trigger": "mdi:calendar-remove"
    },
    "paused": {
      "trigger": "mdi:pause-circle-outline"
    },
    "resumed": {
      "trigger": "mdi:play-circle-outline"
    }
  },
  "conditions": {
    "is_paused": {
      "condition": "mdi:pause-circle-outline"
    },
    "is_active": {
      "condition": "mdi:calendar-check"
    }
  }
}
