{
  "entity": {
    "binary_sensor": {
      "hub_problem": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "sensor": {
      "schedule": {
        "default": "mdi:calendar-clock"
      },
      "health": {
        "default": "mdi:heart-pulse",
        "state": {
          "degraded": "mdi:heart-flash",
          "error": "mdi:heart-off"
        }
      },
      "hub_routines": {
        "default": "mdi:calendar-check"
      }
    },
    "switch": {
      "routine": {
        "default": "mdi:calendar-clock",
        "state": {
          "off": "mdi:calendar-remove"
        }
      },
      "catch_up": {
        "default": "mdi:history"
      },
      "respect_manual": {
        "default": "mdi:account-check"
      },
      "manual_override": {
        "default": "mdi:account-cog",
        "state": {
          "off": "mdi:account-cog-outline"
        }
      }
    },
    "time": {
      "on_time": {
        "default": "mdi:clock-start"
      },
      "turn_on_at": {
        "default": "mdi:clock-start"
      },
      "start_at": {
        "default": "mdi:clock-start"
      },
      "open_at": {
        "default": "mdi:clock-start"
      },
      "off_time": {
        "default": "mdi:clock-end"
      },
      "turn_off_at": {
        "default": "mdi:clock-end"
      },
      "return_to_dock_at": {
        "default": "mdi:clock-end"
      },
      "close_at": {
        "default": "mdi:clock-end"
      },
      "lock_at": {
        "default": "mdi:clock-end"
      }
    },
    "select": {
      "days": {
        "default": "mdi:calendar-week"
      },
      "target": {
        "default": "mdi:target"
      }
    },
    "number": {
      "turn_off_after": {
        "default": "mdi:timer-off-outline"
      },
      "turn_back_on_after": {
        "default": "mdi:timer-refresh-outline"
      }
    },
    "button": {
      "skip_next": {
        "default": "mdi:skip-next"
      },
      "resume": {
        "default": "mdi:play"
      },
      "hub_cleanup_now": {
        "default": "mdi:broom"
      }
    },
    "datetime": {
      "paused_until": {
        "default": "mdi:pause-circle-outline"
      }
    }
  },
  "triggers": {
    "action_skipped": {
      "trigger": "mdi:calendar-remove"
    },
    "paused": {
      "trigger": "mdi:pause-circle-outline"
    },
    "resumed": {
      "trigger": "mdi:play-circle-outline"
    }
  },
  "conditions": {
    "is_paused": {
      "condition": "mdi:pause-circle-outline"
    },
    "is_active": {
      "condition": "mdi:calendar-check"
    }
  },
  "services": {
    "skip_next": {
      "service": "mdi:skip-next"
    },
    "pause": {
      "service": "mdi:pause-circle-outline"
    },
    "resume": {
      "service": "mdi:play-circle-outline"
    },
    "enable": {
      "service": "mdi:calendar-check"
    },
    "disable": {
      "service": "mdi:calendar-remove"
    },
    "maintenance": {
      "service": "mdi:broom"
    }
  }
}
