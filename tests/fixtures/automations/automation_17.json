{
  "config": {
    "id": "automation_17",
    "alias": "Automation 17",
    "description": "Description.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.example_binary_sensor_4",
        "to": "on",
        "for": "00:00:05"
      }
    ],
    "conditions": [
      {
        "condition": "or",
        "conditions": [
          {
            "condition": "time",
            "after": "05:15:00",
            "before": "22:00:00",
            "weekday": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri"
            ]
          },
          {
            "condition": "time",
            "after": "06:30:00",
            "before": "22:00:00",
            "weekday": [
              "sat",
              "sun"
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "choose": [
          {
            "conditions": [
              "{{ grace_active }}"
            ],
            "sequence": [
              {
                "action": "timer.cancel",
                "target": {
                  "entity_id": "timer.example_timer_3"
                }
              },
              {
                "action": "timer.cancel",
                "target": {
                  "entity_id": "timer.example_timer_2"
                }
              },
              {
                "if": [
                  "{{ session_min >= 5 }}",
                  {
                    "condition": "state",
                    "entity_id": "switch.example_switch_4",
                    "state": "off"
                  },
                  {
                    "condition": "state",
                    "entity_id": "input_boolean.example_input_boolean_1",
                    "state": "off"
                  }
                ],
                "then": [
                  {
                    "action": "switch.turn_on",
                    "target": {
                      "entity_id": "switch.example_switch_4"
                    }
                  }
                ]
              }
            ]
          }
        ],
        "default": [
          {
            "action": "input_datetime.set_datetime",
            "target": {
              "entity_id": "input_datetime.example_input_datetime_2"
            },
            "data": {
              "datetime": "{{ now() }}"
            }
          },
          {
            "action": "input_boolean.turn_off",
            "target": {
              "entity_id": [
                "input_boolean.example_input_boolean_1",
                "input_boolean.example_input_boolean_3",
                "input_boolean.example_input_boolean_2"
              ]
            }
          }
        ]
      }
    ],
    "mode": "queued",
    "max": 5,
    "variables": {
      "grace_active": "{{ is_state('timer.example_timer_3','active') }}",
      "session_ts": "{{ state_attr('input_datetime.example_input_datetime_2','timestamp') or 0 }}",
      "session_min": "{{ ((now().timestamp() - session_ts)/60) if session_ts else 0 }}"
    }
  },
  "related": {
    "entity": [
      "binary_sensor.example_binary_sensor_4",
      "input_boolean.example_input_boolean_1",
      "input_boolean.example_input_boolean_3",
      "input_boolean.example_input_boolean_2",
      "input_datetime.example_input_datetime_2",
      "switch.example_switch_4",
      "timer.example_timer_2",
      "timer.example_timer_3"
    ],
    "device": [
      "ee00000000000000000000000000000b",
      "ee00000000000000000000000000000c"
    ],
    "area": [
      "area_1"
    ],
    "floor": [
      "upper"
    ]
  }
}
