{
  "config": {
    "id": "automation_27",
    "alias": "Automation 27",
    "description": "Description.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.example_binary_sensor_6",
        "to": "on"
      }
    ],
    "conditions": [],
    "actions": [
      {
        "action": "input_boolean.turn_on",
        "target": {
          "entity_id": "input_boolean.example_input_boolean_2"
        }
      },
      {
        "if": [
          {
            "condition": "state",
            "entity_id": "switch.example_switch_4",
            "state": "off"
          },
          {
            "condition": "template",
            "alias": "Step",
            "value_template": "{% set m = states.binary_sensor.example_binary_sensor_4 %}{% set s = states.input_boolean.example_input_boolean_1 %}{{ s is none or s.state == 'off' or (m is not none and m.last_changed > s.last_changed) }}"
          }
        ],
        "then": [
          {
            "action": "switch.turn_on",
            "target": {
              "entity_id": "switch.example_switch_4"
            }
          }
        ]
      }
    ],
    "mode": "single"
  },
  "related": {
    "entity": [
      "binary_sensor.example_binary_sensor_6",
      "input_boolean.example_input_boolean_2",
      "switch.example_switch_4"
    ],
    "device": [
      "ee00000000000000000000000000000b"
    ],
    "area": [
      "area_1"
    ],
    "floor": [
      "upper"
    ]
  }
}
