            ],
            "then": [
              {
                "action": "switch.turn_on",
                "target": {
                  "entity_id": "switch.example_switch_5"
                }
              }
            ]
          }
        ],
        "else": [
          {
            "if": [
              {
                "condition": "state",
                "entity_id": "switch.example_switch_5",
                "state": "on"
              }
            ],
            "then": [
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "switch.example_switch_5"
                }
              }
            ]
          }
        ]
      }
    ],
    "mode": "queued",
